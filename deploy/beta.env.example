# Apenas configuracao publica. Nunca coloque segredos neste arquivo.
SCRIBRIEF_PROJECT_NAME=scribrief-beta
# Primeiro acesso: mantenha ambos os binds em loopback ate trocar ADMIN123.
PUBLIC_BIND_IP=127.0.0.1
PUBLIC_HOSTNAME=127.0.0.1
PUBLIC_HTTPS_PORT=18574
ADMIN_BIND_IP=127.0.0.1
ADMIN_HOSTNAME=127.0.0.1
ADMIN_HTTPS_PORT=18575
MAX_UPLOAD_MB=5120
# MiB; MAX_UPLOAD_MB tem teto absoluto de 5120 (5 GiB).
# Staging + reservas multipart: total da instalacao e por usuario.
STAGED_UPLOAD_MAX_MB=20480
STAGED_UPLOAD_USER_MAX_MB=10240
# Espaco livre a preservar no volume privado antes de aceitar outro envio.
MEDIA_MIN_FREE_MB=1024
